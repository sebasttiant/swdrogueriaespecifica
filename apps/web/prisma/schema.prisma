// ==========================================================================
// Droguería Específica — Prisma schema (Fase 1)
//
// Base de datos PREPARADA para la lógica futura, pero SIN reglas de negocio
// implementadas todavía. La lógica (Pendiente -> Faltante automático ->
// Entrada -> Dashboard/Reportes) se cablea en fases posteriores.
//
// Prisma 7: generador rust-free `prisma-client` + driver adapter (pg).
// El cliente generado se importa desde `../lib/generated/prisma/client`.
// ==========================================================================

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  // Prisma 7: la URL de conexión vive en `prisma.config.ts` (no acá).
  provider = "postgresql"
}

// --------------------------------------------------------------------------
// Enums de estado (definidos desde Fase 1 para no migrar tipos más tarde)
// --------------------------------------------------------------------------

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  OPERADOR
}

enum PendingStatus {
  PENDIENTE
  PARCIAL
  ENTREGADO
  CANCELADO
}

enum MissingItemStatus {
  FALTANTE
  PEDIDO
  RECIBIDO
  CANCELADO
}

// Estado de un reporte provisional de faltante hecho por un vendedor. Empieza
// mínimo: todo reporte nace pendiente de revisión de gerencia. Los estados de
// resolución (vinculado, descartado) llegan cuando se implemente la cola de
// revisión, sin migración de datos.
enum MissingReportStatus {
  PENDING_REVIEW
}

enum AuditResult {
  SUCCESS
  FAILURE
}

// Estado del lote: SOLO decisiones humanas. "Vencido" (lo decide el reloj) y
// "agotado" (lo decide la cantidad) son DERIVADOS, nunca se guardan acá.
enum BatchStatus {
  DISPONIBLE
  CUARENTENA
  RETENIDO
}

// --------------------------------------------------------------------------
// Usuarios
// --------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // se completa cuando se implemente auth (Fase 2)
  role         UserRole @default(OPERADOR)
  active       Boolean   @default(true)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Entidades creadas por este usuario (trazabilidad de autoría)
  pendings        Pending[] @relation("PendingCreatedBy")
  // Pendientes cancelados / entregas registradas por este usuario (Slice A:
  // ciclo de vida de entrega). Relaciones nombradas porque `Pending` ahora
  // tiene más de una relación con `User`.
  pendingsCancelled Pending[] @relation("PendingCancelledBy")
  pendingDeliveries PendingDelivery[] @relation("PendingDeliveredBy")
  missingItems    MissingItem[] @relation("MissingItemCreatedBy")
  confirmedMissingItems MissingItem[] @relation("MissingItemConfirmedBy")
  inventoryEntries InventoryEntry[]
  auditLogs       AuditLog[]
  orderedMissingItems MissingItem[] @relation("MissingItemOrderedBy")
  missingReports  MissingReport[] @relation("MissingReportReportedBy")

  @@index([active])
  @@index([archivedAt])
  @@map("users")
}



// --------------------------------------------------------------------------
// Productos
// --------------------------------------------------------------------------

model Product {
  id         String   @id @default(cuid())
  code       String   @unique // SKU / código interno
  name       String
  unit       String // unidad de medida (ej: "unidad", "caja", "ml")
  minStock   Int      @default(0) // stock mínimo para alertas
  reorderQty Int      @default(0) // cantidad sugerida de reorden
  active     Boolean  @default(true)
  // Producto creado al vuelo desde un pendiente manual (no estaba en catálogo).
  // Queda marcado para que un ADMIN lo complete/apruebe (código y unidad reales).
  needsReview Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pendings         Pending[]
  missingItems     MissingItem[]
  inventoryEntries InventoryEntry[]
  batches          ProductBatch[]
  laboratoryId     String?
  laboratory       Laboratory? @relation(fields: [laboratoryId], references: [id])
  suppliers        ProductSupplier[]

  @@index([active])
  @@index([name])
  @@index([needsReview])
  @@map("products")
}

model Laboratory {
  id       String    @id @default(cuid())
  name     String    @unique
  phone    String?
  email    String?
  products Product[]

  @@map("laboratories")
}

model Supplier {
  id       String            @id @default(cuid())
  name     String            @unique
  phone    String?
  address  String?
  email    String?
  products ProductSupplier[]
  items    MissingItem[]

  @@map("suppliers")
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  isRecurrent Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// --------------------------------------------------------------------------
// Lotes de inventario (ProductBatch)
//
// El stock físico real vive acá, no en Product. Cada lote tiene su propio
// vencimiento. Stock vendible = status DISPONIBLE && quantity > 0 && no vencido
// (se calcula por query, NO se cachea en Product).
// --------------------------------------------------------------------------

model ProductBatch {
  id        String      @id @default(cuid())
  product   Product     @relation(fields: [productId], references: [id])
  productId String
  batchCode String // número de lote del proveedor
  expiresAt DateTime // vencimiento de ESTE lote
  quantity  Int // stock físico de ESTE lote
  location  String? // ubicación física (estante, depósito)
  status    BatchStatus @default(DISPONIBLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([productId, batchCode])
  @@index([expiresAt]) // alertas de vencimiento globales (futuro)
  @@index([productId, status]) // stock vendible por producto
  @@index([productId, expiresAt, id]) // listado paginado por producto (where+orderBy)
  @@map("product_batches")
}

// --------------------------------------------------------------------------
// Pendientes (solicitudes de cliente)
// --------------------------------------------------------------------------

model Pending {
  id           String        @id @default(cuid())
  product      Product       @relation(fields: [productId], references: [id])
  productId    String
  quantity     Int
  status       PendingStatus @default(PENDIENTE)
  // Promesa de entrega al cliente: cuándo le respondemos. Obligatoria: en
  // droguería el pendiente es operativo y necesita una fecha/hora comprometida.
  promisedAt   DateTime
  customerName String?
  note         String?
  createdBy    User?         @relation("PendingCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // --------------------------------------------------------------------
  // Ciclo de vida de entrega (Slice A): entregas parciales + cancelación.
  // `deliveredQuantity` es la SUMA desnormalizada de sus `PendingDelivery`,
  // mantenida por el service dentro de la misma transacción que crea la
  // entrega. `completedAt` solo se completa en la transición a ENTREGADO.
  // --------------------------------------------------------------------
  deliveredQuantity Int              @default(0)
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledBy       User?            @relation("PendingCancelledBy", fields: [cancelledById], references: [id])
  cancelledById     String?
  cancelReason      String?
  deliveries        PendingDelivery[]

  // Faltantes generados a partir de este pendiente (lógica de Fase 2)
  missingItems MissingItem[]

  @@index([status])
  @@index([productId])
  @@index([createdAt])
  @@map("pendings")
}

// --------------------------------------------------------------------------
// Entregas de un pendiente (Slice A). Cada fila es UNA entrega parcial o
// total registrada por un operador. La entrega NUNCA descuenta stock ni toca
// `MissingItem` — ver el comentario de cabecera de `pending.service.ts`.
// --------------------------------------------------------------------------

model PendingDelivery {
  id            String   @id @default(cuid())
  pending       Pending  @relation(fields: [pendingId], references: [id])
  pendingId     String
  quantity      Int
  deliveredAt   DateTime @default(now())
  deliveredBy   User?    @relation("PendingDeliveredBy", fields: [deliveredById], references: [id])
  deliveredById String?
  createdAt     DateTime @default(now())

  @@index([pendingId])
  @@map("pending_deliveries")
}

// --------------------------------------------------------------------------
// Faltantes (lo que hay que conseguir/pedir)
// --------------------------------------------------------------------------

model MissingItem {
  id          String            @id @default(cuid())
  product     Product           @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  // Cantidad que gerencia efectivamente pidió al proveedor. Distinta de
  // `quantity` (necesidad/déficit histórico): null mientras el faltante sigue
  // abierto, y en registros anteriores a esta columna. Nunca se deriva de
  // `quantity`. Un CHECK aditivo refuerza `IS NULL OR > 0`.
  orderedQuantity Int?
  note        String?
  status      MissingItemStatus @default(FALTANTE)
  // Pendiente que lo originó (cuando se genera automáticamente). Null = manual.
  origin      Pending?          @relation(fields: [originId], references: [id])
  originId    String?
  createdBy   User?             @relation("MissingItemCreatedBy", fields: [createdById], references: [id])
  createdById String?
  confirmedAt DateTime?
  confirmedBy User?             @relation("MissingItemConfirmedBy", fields: [confirmedById], references: [id])
  confirmedById String?
  confirmationNote String?
  orderedAt DateTime?
  orderedBy User? @relation("MissingItemOrderedBy", fields: [orderedById], references: [id])
  orderedById String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([confirmedAt])
  @@index([status, confirmedAt])
  @@index([productId])
  @@index([createdAt])
  @@map("missing_items")
}

// --------------------------------------------------------------------------
// Entradas de inventario
// --------------------------------------------------------------------------

model InventoryEntry {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  note        String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_entries")
}

// --------------------------------------------------------------------------
// Auditoría — base obligatoria desde Fase 1.
// Responde: quién, cuándo, qué, sobre qué registro, qué cambió, desde dónde,
// y si fue exitoso o fallido.
//
// `action` es String (no enum) a propósito: la lista de acciones crece por
// fase. Las acciones canónicas viven en `lib/constants/audit.ts` (AUDIT_ACTIONS).
// --------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(cuid())
  // Responsable (puede ser null para acciones del sistema o login fallido)
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  action    String // ej: "product.create", "auth.login.failed"
  module    String // ej: "productos", "auth", "entradas"
  entity    String // nombre de la entidad afectada, ej: "Product"
  entityId  String? // id del registro afectado (si aplica)
  result    AuditResult @default(SUCCESS)
  ip        String?
  userAgent String?
  channel   String? // canal/método de ingreso, ej: "web", "mobile"
  before    Json? // estado anterior (si aplica)
  after     Json? // estado nuevo (si aplica)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entity, entityId])
  @@index([result])
  @@index([createdAt])
  @@map("audit_logs")
}

// Reporte provisional de un faltante hecho por un vendedor desde el celular.
// NO es un Product ni un MissingItem canónico: solo dice "este producto (por su
// nombre) quedó en cero", pendiente de que gerencia lo revise. `rawName` es lo
// que el vendedor pegó desde Orión, tal cual, para mostrar; `normalizedName` es
// la forma comparable, para agrupar reportes del mismo producto en el futuro.
// Deliberadamente sin cantidad, proveedor, foto ni vínculo a catálogo: esos ejes
// llegan en fases posteriores, cada una con su migración aditiva.
model MissingReport {
  id             String              @id @default(cuid())
  rawName        String
  normalizedName String
  reporter       User                @relation("MissingReportReportedBy", fields: [reporterId], references: [id])
  reporterId     String
  status         MissingReportStatus @default(PENDING_REVIEW)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // La cola de revisión filtra por `status` y agrupa/consulta por
  // `normalizedName` (groupBy de pendientes + findMany por nombre). Este índice
  // compuesto sirve ambas consultas. Es el ÚNICO índice justificado hoy: no hay
  // consulta que motive uno por `reporterId` ni `createdAt` sueltos.
  @@index([status, normalizedName])
  @@map("missing_reports")
}
