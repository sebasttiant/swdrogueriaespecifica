// ==========================================================================
// Droguería Específica — Prisma schema (Fase 1)
//
// Base de datos PREPARADA para la lógica futura, pero SIN reglas de negocio
// implementadas todavía. La lógica (Pendiente -> Faltante automático ->
// Entrada -> Dashboard/Reportes) se cablea en fases posteriores.
//
// Prisma 7: generador rust-free `prisma-client` + driver adapter (pg).
// El cliente generado se importa desde `../lib/generated/prisma/client`.
// ==========================================================================

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  // Prisma 7: la URL de conexión vive en `prisma.config.ts` (no acá).
  provider = "postgresql"
}

// --------------------------------------------------------------------------
// Enums de estado (definidos desde Fase 1 para no migrar tipos más tarde)
// --------------------------------------------------------------------------

enum UserRole {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  OPERADOR
  BODEGA
}

enum PendingPurchaseStatus {
  POR_PEDIR
  SOLICITADO
  BUSQUEDA
  COTIZANDO
  AGOTADO
}

enum PendingAvailabilityStatus {
  ESPERANDO
  LLEGO_BODEGA
  DISPONIBLE_PARCIAL
  DISPONIBLE_COMPLETO
}

// Qué respondió el cliente sobre lo que faltó de una entrega parcial. Solo las
// respuestas que dejan el pendiente ABIERTO: "no los espera" lo cierra, y eso
// ya se ve en el estado.
enum PendingPartialDecision {
  ESPERA
  VA_CON_PEDIDO
}

enum PendingCustomerStatus {
  POR_CONTACTAR
  CONTACTADO
  FACTURADO
  ENTREGADO
  CANCELADO
}

enum PendingStatus {
  PENDIENTE
  PARCIAL
  ENTREGADO
  CANCELADO
  // Cierre parcial (T2.2b): se entregó una parte y el cliente no espera el
  // resto. Terminal, pero DISTINTO de ENTREGADO/CANCELADO: la ecuación
  // `deliveredQuantity + cancelledQuantity = quantity` es la única forma de
  // saber cuánto se perdió del pedido original sin inventar una historia.
  CLOSED_PARTIAL
  // Estados de gestión (Mejora 2): los fija gerencia/compras sobre un pendiente
  // abierto. AGOTADO no cancela: es una señal para que el vendedor rechace el
  // pendiente por el flujo normal. Ver features/pendientes/management-status.ts.
  SOLICITADO
  BUSQUEDA
  COTIZANDO
  AGOTADO
}

enum MissingItemStatus {
  FALTANTE
  PEDIDO
  EN_BODEGA
  RECIBIDO
  CANCELADO
}

// Estado de un reporte provisional de faltante hecho por un vendedor. Empieza
// mínimo: todo reporte nace pendiente de revisión de gerencia. Los estados de
// resolución (vinculado, descartado) llegan cuando se implemente la cola de
// revisión, sin migración de datos.
enum MissingReportStatus {
  PENDING_REVIEW
  // Gerencia ya lo revisó y lo vinculó a un producto del catálogo, generando el
  // faltante canónico. Sale de la cola de revisión, pero la fila se conserva:
  // es el rastro de quién reportó y cuándo.
  LINKED
  // Gerencia ya lo compró, sin vincularlo al catálogo. Es la salida rápida de la
  // cola: el gerente lee el nombre que escribió el vendedor, sabe qué producto
  // es y lo pide por teléfono. Exigirle buscarlo en el catálogo para poder
  // marcarlo era el cuello de botella que hacía crecer la cola sin freno.
  ORDERED
  // Gerencia decidió que no se pide (duplicado, o ya no hace falta). Sale de la
  // cola sin afirmar que se compró. Eje opuesto a ORDERED: nunca se mezclan.
  DISCARDED
  // La mercadería llegó. Cierra el ciclo del reporte a mano, y hace falta
  // justamente porque estos reportes no se vinculan al catálogo: sin producto
  // asociado, el cierre automático por entrada de inventario no los alcanza y
  // quedarían en ORDERED para siempre.
  //
  // NO mueve stock: eso lo hace la entrada de inventario, que es otro hecho.
  // Mezclarlos haría creer que marcar "ya llegó" subió el inventario.
  RECEIVED
  // Llegó físicamente, pero bodega todavía no cargó el lote/entrada real.
  EN_BODEGA
}

enum AuditResult {
  SUCCESS
  FAILURE
}

// Estado del lote: SOLO decisiones humanas. "Vencido" (lo decide el reloj) y
// "agotado" (lo decide la cantidad) son DERIVADOS, nunca se guardan acá.
enum BatchStatus {
  DISPONIBLE
  CUARENTENA
  RETENIDO
}

// --------------------------------------------------------------------------
// Usuarios
// --------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // se completa cuando se implemente auth (Fase 2)
  role         UserRole @default(OPERADOR)
  active       Boolean   @default(true)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Entidades creadas por este usuario (trazabilidad de autoría)
  pendings        Pending[] @relation("PendingCreatedBy")
  // Pendientes cancelados / entregas registradas por este usuario (Slice A:
  // ciclo de vida de entrega). Relaciones nombradas porque `Pending` ahora
  // tiene más de una relación con `User`.
  pendingsCancelled Pending[] @relation("PendingCancelledBy")
  pendingDeliveries PendingDelivery[] @relation("PendingDeliveredBy")
  contactedPendings Pending[] @relation("PendingContactedBy")
  invoicedPendings Pending[] @relation("PendingInvoicedBy")
  missingItems    MissingItem[] @relation("MissingItemCreatedBy")
  confirmedMissingItems MissingItem[] @relation("MissingItemConfirmedBy")
  inventoryEntries InventoryEntry[]
  auditLogs       AuditLog[]
  orderedMissingItems MissingItem[] @relation("MissingItemOrderedBy")
  discardedMissingItems MissingItem[] @relation("MissingItemDiscardedBy")
  missingReports  MissingReport[] @relation("MissingReportReportedBy")
  resolvedMissingReports MissingReport[] @relation("MissingReportResolvedBy")
  arrivedMissingReports MissingReport[] @relation("MissingReportArrivedBy")
  arrivedMissingItems MissingItem[] @relation("MissingItemArrivedBy")

  @@index([active])
  @@index([archivedAt])
  @@map("users")
}



// --------------------------------------------------------------------------
// Productos
// --------------------------------------------------------------------------

// Estado de la identidad de un producto. PROVISIONAL_REVIEW es el producto que
// entró al catálogo con un SKU acuñado por el servidor y todavía espera que
// alguien le vincule el código Orion real.
enum SkuStatus {
  PROVISIONAL_REVIEW
  CONFIRMED
}

model Product {
  id         String   @id @default(cuid())
  code       String   @unique // SKU / código interno
  name       String
  unit       String // unidad de medida (ej: "unidad", "caja", "ml")
  minStock   Int      @default(0) // stock mínimo para alertas
  reorderQty Int      @default(0) // cantidad sugerida de reorden
  active     Boolean  @default(true)
  // Producto creado al vuelo desde un pendiente manual (no estaba en catálogo).
  // Queda marcado para que un ADMIN lo complete/apruebe (código y unidad reales).
  needsReview Boolean @default(false)
  // Clave canónica solo para productos provisionales creados desde reportes.
  // El unique hace idempotente la creación concurrente por nombre normalizado.
  provisionalNormalizedName String? @unique
  // Identidad canónica del producto en Orion: exacta e INMUTABLE una vez
  // vinculada. Nula mientras nadie la vinculó; el vínculo y el remapeo quedan
  // auditados. Las reglas viven en server/domain/catalog/sku-identity.ts.
  orionCode   String?  @unique
  // SKU interno que acuña el servidor (`PRV-{ULID}`) cuando el producto entra
  // al catálogo sin código Orion. Único y buscable de forma exacta.
  internalSku String?  @unique
  // Marca de revisión de identidad. Nula en el catálogo histórico, que nunca
  // pasó por este flujo.
  skuStatus   SkuStatus?
  // Contador del compare-and-set que protege el vínculo con el código Orion:
  // quien escribe declara la versión que observó y pierde si otro llegó antes.
  identityVersion Int @default(0)
  // Clave del INTENTO que acuñó la identidad: un reintento del operador
  // devuelve el mismo producto en lugar de acuñar otro.
  identityCommandKey String? @unique
  // Huella del contenido del comando: la misma clave con otro contenido es un
  // error del llamador, no un reintento.
  identityCommandFingerprint String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pendings         Pending[]
  missingItems     MissingItem[]
  inventoryEntries InventoryEntry[]
  batches          ProductBatch[]
  // Lotes del modelo canónico (T1.2). Convive con `batches`, que es el legado.
  lots             Lot[]
  laboratoryId     String?
  laboratory       Laboratory? @relation(fields: [laboratoryId], references: [id])
  suppliers        ProductSupplier[]

  @@index([active])
  @@index([name])
  @@index([needsReview])
  // La cola de revisión de identidad se lee por este estado.
  @@index([skuStatus])
  @@map("products")
}

// --------------------------------------------------------------------------
// Modelo CANÓNICO de lote (T1.2).
//
// Convive con `ProductBatch`, que es el modelo legado del stock físico y sigue
// en uso hasta el cutover. Acá no se migran datos: el canónico se construye en
// paralelo y el reemplazo se decide después.
//
// Dos decisiones que valen la pena leer antes de tocarlo:
//
//  - `expiresAt` es NULLABLE. No todo lo que entra a la droguería vence, y
//    obligar la fecha llevaría a inventarla. FEFO los ordena al final.
//  - VENCIDO no es un estado guardado: se DERIVA comparando `expiresAt` con el
//    momento de la consulta. Un estado guardado se desincroniza el día que
//    nadie corre el proceso que lo actualiza.
// --------------------------------------------------------------------------

enum LotStatus {
  AVAILABLE
  QUARANTINED
}

model Lot {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  lotNumber String // número de lote del proveedor
  // Nulo = sin vencimiento. FEFO lo manda al final, no al principio.
  expiresAt DateTime?
  // Cantidad física. La no-negatividad la sostiene un CHECK en la base, no
  // solo el código: es la red que atrapa cualquier sobre-descuento futuro.
  onHand    Int
  // Momento de recepción: desempata FEFO cuando dos lotes vencen el mismo día.
  receivedAt DateTime @default(now())
  status    LotStatus @default(AVAILABLE)
  location  String? // ubicación física (estante, depósito)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  movements InventoryMovement[]

  @@unique([productId, lotNumber]) // identidad del lote
  @@index([expiresAt]) // alertas de vencimiento globales
  @@index([productId, status])
  @@index([productId, expiresAt, id]) // orden FEFO por producto
  @@map("lots")
}

// --------------------------------------------------------------------------
// Ledger inmutable de movimientos + store de comandos (T1.3).
//
// El ledger es el registro contable del inventario canónico: cada cambio de
// cantidad queda como un asiento que NO se edita ni se borra. Por eso la tabla
// no tiene `updatedAt` y el repositorio no expone update ni delete.
//
// Todo movimiento nace de un comando. Esa es la regla que hace que no haya
// cambios sin rastro, y el `@@unique([commandId])` la sostiene: un comando
// asienta una vez, aunque el llamador reintente.
// --------------------------------------------------------------------------

// Nombres técnicos en inglés (RECEIPT=entrada, RESERVATION=reserva,
// RELEASE=liberación, DELIVERY=entrega, ADJUSTMENT=ajuste, RETURN=devolución,
// EXPIRY=vencimiento).
enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  DELIVERY
  ADJUSTMENT
  RETURN
  EXPIRY
}

model OperationalCommand {
  id          String   @id @default(cuid())
  actorId     String
  // String y no enum a propósito: el store no se acopla a la lista de comandos
  // del negocio, que crece con cada flujo.
  commandType String
  // Clave de idempotencia del llamador. El store la normaliza a minúsculas.
  commandKey  String
  // SHA-256 hex del payload canónico: ata la clave al contenido real.
  fingerprint String
  // De los dos, al menos uno no es nulo: un comando terminó con resultado o
  // con error. Lo garantiza un CHECK en la base.
  result      Json?
  error       Json?
  createdAt   DateTime @default(now())

  movements InventoryMovement[]

  @@unique([actorId, commandType, commandKey]) // identidad del comando
  @@index([actorId, createdAt])
  @@map("operational_commands")
}

model InventoryMovement {
  id        String                @id @default(cuid())
  // RESTRICT y no CASCADE: el ledger se retiene de forma permanente. Un lote
  // con movimientos no se borra, y un producto con movimientos se desactiva.
  // Un ledger que un DELETE puede borrar no es un ledger.
  lot       Lot                   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  lotId     String
  // Denormalizado del lote al asentar: evita un join por consulta y queda
  // congelado con el hecho.
  productId String
  type      InventoryMovementType
  // Delta firmado. El ledger guarda el hecho bruto; el significado por tipo lo
  // interpretan los comandos y las derivaciones de T1.4.
  quantity  Int
  actorId   String
  occurredAt DateTime             @default(now())
  // Todo movimiento nace de un comando: cero cambios sin rastro.
  command   OperationalCommand    @relation(fields: [commandId], references: [id], onDelete: Restrict)
  commandId String
  createdAt DateTime              @default(now())

  @@unique([commandId]) // un comando asienta UNA vez: sin doble asiento
  @@index([lotId])
  // La derivación de cantidades (T1.4) suma los movimientos de UN lote
  // filtrando por tipo. El ledger se retiene de forma permanente, así que sin
  // este índice esa suma recorre una historia que solo crece.
  @@index([lotId, type])
  @@index([productId, occurredAt])
  @@index([productId, type])
  @@map("inventory_movements")
}

model Laboratory {
  id       String    @id @default(cuid())
  name     String    @unique
  phone    String?
  email    String?
  products Product[]

  @@map("laboratories")
}

model Supplier {
  id       String            @id @default(cuid())
  name     String            @unique
  phone    String?
  address  String?
  email    String?
  products ProductSupplier[]
  items    MissingItem[]

  @@map("suppliers")
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  isRecurrent Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// --------------------------------------------------------------------------
// Lotes de inventario (ProductBatch)
//
// El stock físico real vive acá, no en Product. Cada lote tiene su propio
// vencimiento. Stock vendible = status DISPONIBLE && quantity > 0 && no vencido
// (se calcula por query, NO se cachea en Product).
// --------------------------------------------------------------------------

model ProductBatch {
  id        String      @id @default(cuid())
  product   Product     @relation(fields: [productId], references: [id])
  productId String
  batchCode String // número de lote del proveedor
  expiresAt DateTime // vencimiento de ESTE lote
  quantity  Int // stock físico de ESTE lote
  location  String? // ubicación física (estante, depósito)
  status    BatchStatus @default(DISPONIBLE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  pendingReservations PendingInventoryReservation[]

  @@unique([productId, batchCode])
  @@index([expiresAt]) // alertas de vencimiento globales (futuro)
  @@index([productId, status]) // stock vendible por producto
  @@index([productId, expiresAt, id]) // listado paginado por producto (where+orderBy)
  @@map("product_batches")
}

// --------------------------------------------------------------------------
// Pendientes (solicitudes de cliente)
// --------------------------------------------------------------------------

model Pending {
  id           String        @id @default(cuid())
  product      Product       @relation(fields: [productId], references: [id])
  productId    String
  quantity     Int
  status       PendingStatus @default(PENDIENTE)
  // Ejes independientes: compras, disponibilidad física y relación comercial.
  // `status` se conserva para compatibilidad histórica de listados existentes.
  purchaseStatus PendingPurchaseStatus @default(POR_PEDIR)
  availabilityStatus PendingAvailabilityStatus @default(ESPERANDO)
  customerStatus PendingCustomerStatus @default(POR_CONTACTAR)
  inventoryReadyQuantity Int @default(0)
  reservedInventoryQuantity Int @default(0)
  invoicedQuantity Int @default(0)
  contactedAt DateTime?
  contactedBy User? @relation("PendingContactedBy", fields: [contactedById], references: [id])
  contactedById String?
  invoicedAt DateTime?
  invoicedBy User? @relation("PendingInvoicedBy", fields: [invoicedById], references: [id])
  invoicedById String?
  // Cuándo el VENDEDOR corrigió su propio pendiente. Puede hacerlo una sola vez:
  // equivocarse al cargar pasa, corregir en bucle es reescribir la historia de
  // un compromiso con un cliente. Gerencia no tiene ese límite.
  // Null = todavía no lo corrigió. Las ediciones de gerencia NO lo tocan.
  sellerEditedAt DateTime?
  // La respuesta del cliente sobre el resto, ya registrada. Sin esto la fila no
  // sabía que la pregunta ya se había contestado y la volvía a hacer para
  // siempre: la nota se escribía, pero nada la delataba.
  partialDecision   PendingPartialDecision?
  partialDecisionAt DateTime?
  // Promesa de entrega al cliente: cuándo le respondemos. Obligatoria: en
  // droguería el pendiente es operativo y necesita una fecha/hora comprometida.
  promisedAt   DateTime
  // Nombre y teléfono del cliente. Obligatorios EN EL FORMULARIO desde julio de
  // 2026 (pedido de gerencia: sin teléfono no se puede avisar que llegó), pero
  // la columna sigue siendo nullable a propósito.
  //
  // Volverlas NOT NULL obligaría a inventarle un valor a cada pendiente
  // anterior, y ahí la base pasaría a mentir sobre el pasado. La regla nueva
  // aplica hacia adelante; la historia se conserva como fue.
  customerName String?
  customerPhone String?
  // Dirección de entrega del cliente. Opcional: la zona ya da el ruteo grueso,
  // la dirección exacta afina la entrega. Es PII —dónde vive el cliente—, así
  // que se minimiza server-side con `canViewCustomerIdentity`, igual que el
  // nombre y el teléfono.
  customerAddress String?
  note         String?
  // --------------------------------------------------------------------
  // Seguimiento del cliente: zona de entrega y estado de pago.
  //
  // `zone` se guarda YA canonizada (ver features/pendientes/zone.ts): agrupar
  // por zona con texto libre sin normalizar daría zonas duplicadas.
  //
  // `totalAmount`/`paidAmount` son ENTEROS de pesos colombianos, sin centavos.
  // Nunca un Float: la aritmética binaria de punto flotante no representa
  // exacto los decimales y el dinero no admite ese error.
  //
  // No existe una columna "pagado": ese estado se DERIVA de ambos montos (ver
  // features/pendientes/payment-state.ts). Un flag persistido podría
  // contradecir a los montos y no habría forma de saber cuál vale.
  //
  // Sin índice sobre `zone`: todavía no hay query que agrupe por zona. Se
  // agrega cuando exista el reporte que lo use, no antes.
  // --------------------------------------------------------------------
  zone         String?
  totalAmount  Int?
  paidAmount   Int           @default(0)
  createdBy    User?         @relation("PendingCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  // --------------------------------------------------------------------
  // Clave de idempotencia del INTENTO que creó este pendiente.
  //
  // El formulario genera una clave por intento y la reenvía sin cambiarla
  // mientras el registro siga fallando. Así un reintento —del operador o del
  // navegador tras un timeout— vuelve a caer sobre la MISMA fila en vez de
  // crear una segunda. El índice único es lo que hace cumplir la regla: dos
  // envíos simultáneos con la misma clave no pueden insertar dos veces, porque
  // el segundo choca contra la restricción y se resuelve leyendo el existente.
  //
  // NULLABLE a propósito: en PostgreSQL un índice único admite varios NULL, así
  // que los pendientes anteriores a esta columna conviven sin inventarles una
  // clave. La regla aplica hacia adelante; la historia queda como fue.
  // --------------------------------------------------------------------
  idempotencyKey String?      @unique
  // Canonical representation of the actor and semantic create payload. It is
  // nullable only for rows that predate idempotent Pending creation.
  requestFingerprint String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // --------------------------------------------------------------------
  // Ciclo de vida de entrega (Slice A + T2.2b): entregas parciales,
  // cancelación y cierre parcial.
  // `deliveredQuantity` es la SUMA desnormalizada de sus `PendingDelivery`,
  // mantenida por el service dentro de la misma transacción que crea la
  // entrega. `cancelledQuantity` es lo que el cliente ya no espera (decisión
  // "cerrar" sobre un PARCIAL): la ecuación del cierre parcial es
  // `deliveredQuantity + cancelledQuantity = quantity`. `completedAt` solo se
  // completa en las transiciones terminales (ENTREGADO, CLOSED_PARTIAL).
  // --------------------------------------------------------------------
  deliveredQuantity Int              @default(0)
  cancelledQuantity Int              @default(0)
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledBy       User?            @relation("PendingCancelledBy", fields: [cancelledById], references: [id])
  cancelledById     String?
  cancelReason      String?
  deliveries        PendingDelivery[]

  // Faltantes generados a partir de este pendiente (lógica de Fase 2)
  missingItems MissingItem[]
  inventoryAllocations InventoryAllocation[]
  inventoryReservations PendingInventoryReservation[]

  @@index([status])
  @@index([productId])
  @@index([createdAt])
  @@index([createdById, createdAt])
  @@index([availabilityStatus, customerStatus])
  @@map("pendings")
}

// --------------------------------------------------------------------------
// Entregas de un pendiente (Slice A). Cada fila es UNA entrega parcial o
// total registrada por un operador. La entrega NUNCA descuenta stock ni toca
// `MissingItem` — ver el comentario de cabecera de `pending.service.ts`.
// --------------------------------------------------------------------------

model PendingDelivery {
  id            String   @id @default(cuid())
  pending       Pending  @relation(fields: [pendingId], references: [id])
  pendingId     String
  quantity      Int
  deliveredAt   DateTime @default(now())
  deliveredBy   User?    @relation("PendingDeliveredBy", fields: [deliveredById], references: [id])
  deliveredById String?
  createdAt     DateTime @default(now())

  @@index([pendingId])
  @@map("pending_deliveries")
}

// --------------------------------------------------------------------------
// Faltantes (lo que hay que conseguir/pedir)
// --------------------------------------------------------------------------

model MissingItem {
  id          String            @id @default(cuid())
  product     Product           @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  receivedQuantity Int @default(0)
  // Cantidad que gerencia efectivamente pidió al proveedor. Distinta de
  // `quantity` (necesidad/déficit histórico): null mientras el faltante sigue
  // abierto, y en registros anteriores a esta columna. Nunca se deriva de
  // `quantity`. Un CHECK aditivo refuerza `IS NULL OR > 0`.
  orderedQuantity Int?
  note        String?
  status      MissingItemStatus @default(FALTANTE)
  // Pendiente que lo originó (cuando se genera automáticamente). Null = manual.
  origin      Pending?          @relation(fields: [originId], references: [id])
  originId    String?
  createdBy   User?             @relation("MissingItemCreatedBy", fields: [createdById], references: [id])
  createdById String?
  // Código del vendedor que reportó/registró el faltante (opcional, para trazabilidad operativa).
  sellerCode  String?
  confirmedAt DateTime?
  confirmedBy User?             @relation("MissingItemConfirmedBy", fields: [confirmedById], references: [id])
  confirmedById String?
  confirmationNote String?
  orderedAt DateTime?
  orderedBy User? @relation("MissingItemOrderedBy", fields: [orderedById], references: [id])
  orderedById String?
  arrivedAt DateTime?
  arrivedBy User? @relation("MissingItemArrivedBy", fields: [arrivedById], references: [id])
  arrivedById String?
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?
  // Descarte de un faltante duplicado o que ya no hace falta (status CANCELADO).
  // Columnas PROPIAS a propósito: reutilizar `confirmedAt`/`confirmedById` haría
  // imposible distinguir después un descarte de una confirmación, que es el
  // error que ya obligó a revertir "OK gerencia".
  discardedAt   DateTime?
  // `onDelete: Restrict` is what the database has enforced since this column
  // shipped, and it is the behaviour we want: the actor of a discard must not
  // disappear from the audit trail. Declaring it keeps the datamodel and the
  // database identical instead of reporting drift on every future migration.
  discardedBy   User?    @relation("MissingItemDiscardedBy", fields: [discardedById], references: [id], onDelete: Restrict)
  discardedById String?
  discardReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  inventoryAllocations InventoryAllocation[]

  @@index([status])
  @@index([confirmedAt])
  @@index([status, confirmedAt])
  @@index([productId])
  @@index([status, arrivedAt])
  @@index([createdAt])
  @@map("missing_items")
}

// --------------------------------------------------------------------------
// Entradas de inventario
// --------------------------------------------------------------------------

model InventoryEntry {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int
  idempotencyKey String @unique @default(uuid())
  requestFingerprint String
  note        String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  allocations InventoryAllocation[]

  @@index([productId])
  @@index([createdAt])
  @@index([idempotencyKey, requestFingerprint])
  @@map("inventory_entries")
}

// Una asignación es una reserva cuantificada de una entrada física para un
// faltante concreto. El service la crea FIFO bajo locks; por eso una unidad no
// puede ser asignada dos veces ni un retry duplicar el ledger.
model InventoryAllocation {
  id String @id @default(cuid())
  inventoryEntry InventoryEntry @relation(fields: [inventoryEntryId], references: [id], onDelete: Restrict)
  inventoryEntryId String
  missingItem MissingItem @relation(fields: [missingItemId], references: [id], onDelete: Restrict)
  missingItemId String
  pending Pending? @relation(fields: [pendingId], references: [id], onDelete: SetNull)
  pendingId String?
  quantity Int
  createdAt DateTime @default(now())

  @@unique([inventoryEntryId, missingItemId])
  @@index([missingItemId])
  @@index([pendingId])
  @@map("inventory_allocations")
}

// Saldo reservado por pendiente y lote. Es el ledger que permite devolver solo
// unidades no entregadas al lote físico exacto cuando un pedido se cancela.
model PendingInventoryReservation {
  id String @id @default(cuid())
  pending Pending @relation(fields: [pendingId], references: [id], onDelete: Restrict)
  pendingId String
  batch ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchId String
  quantity Int
  createdAt DateTime @default(now())

  @@unique([pendingId, batchId])
  @@index([pendingId])
  @@index([batchId])
  @@map("pending_inventory_reservations")
}

// --------------------------------------------------------------------------
// Auditoría — base obligatoria desde Fase 1.
// Responde: quién, cuándo, qué, sobre qué registro, qué cambió, desde dónde,
// y si fue exitoso o fallido.
//
// `action` es String (no enum) a propósito: la lista de acciones crece por
// fase. Las acciones canónicas viven en `lib/constants/audit.ts` (AUDIT_ACTIONS).
// --------------------------------------------------------------------------

model AuditLog {
  id        String      @id @default(cuid())
  // Responsable (puede ser null para acciones del sistema o login fallido)
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  action    String // ej: "product.create", "auth.login.failed"
  module    String // ej: "productos", "auth", "entradas"
  entity    String // nombre de la entidad afectada, ej: "Product"
  entityId  String? // id del registro afectado (si aplica)
  result    AuditResult @default(SUCCESS)
  ip        String?
  userAgent String?
  channel   String? // canal/método de ingreso, ej: "web", "mobile"
  before    Json? // estado anterior (si aplica)
  after     Json? // estado nuevo (si aplica)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entity, entityId])
  @@index([result])
  @@index([createdAt])
  @@map("audit_logs")
}

// Reporte provisional de un faltante hecho por un vendedor desde el celular.
// NO es un Product ni un MissingItem canónico: solo dice "este producto (por su
// nombre) quedó en cero", pendiente de que gerencia lo revise. `rawName` es lo
// que el vendedor pegó desde Orión, tal cual, para mostrar; `normalizedName` es
// la forma comparable, para agrupar reportes del mismo producto en el futuro.
// Deliberadamente sin cantidad, proveedor, foto ni vínculo a catálogo: esos ejes
// llegan en fases posteriores, cada una con su migración aditiva.
model MissingReport {
  id             String              @id @default(cuid())
  rawName        String
  normalizedName String
  // Código operativo opcional informado por el vendedor. No es una relación: la
  // identidad del reportante sigue siendo `reporterId`.
  sellerCode     String?
  reporter       User                @relation("MissingReportReportedBy", fields: [reporterId], references: [id])
  reporterId     String
  status         MissingReportStatus @default(PENDING_REVIEW)
  // Resultado de la revisión: a qué producto del catálogo se vinculó y qué
  // faltante canónico se generó. Null mientras el reporte sigue pendiente.
  // Columnas planas (no relaciones): el reporte es un rastro histórico y no debe
  // impedir que un producto se archive.
  linkedProductId     String?
  linkedMissingItemId String?
  // Quién resolvió el reporte por la vía rápida (ORDERED/DISCARDED) y cuándo.
  // La cola la trabajan dos personas a la vez: sin esto había que preguntar por
  // teléfono quién había marcado qué. Null mientras sigue pendiente, y también
  // en los reportes que se resolvieron vinculándolos al catálogo.
  resolvedBy     User?               @relation("MissingReportResolvedBy", fields: [resolvedById], references: [id])
  resolvedById   String?
  resolvedAt     DateTime?
  arrivedBy      User?               @relation("MissingReportArrivedBy", fields: [arrivedById], references: [id])
  arrivedById    String?
  arrivedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // La cola de revisión filtra por `status` y agrupa/consulta por
  // `normalizedName` (groupBy de pendientes + findMany por nombre). Este índice
  // compuesto sirve ambas consultas. Es el ÚNICO índice justificado hoy: no hay
  // consulta que motive uno por `reporterId` ni `createdAt` sueltos.
  @@index([status, normalizedName])
  // Todavía sin consumidor: los agrega D1e-1 para las consultas de trazabilidad
  // que vendrán (qué reportes originaron un faltante / un producto).
  @@index([linkedProductId])
  @@index([linkedMissingItemId])
  @@map("missing_reports")
}
