    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "1.23.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
