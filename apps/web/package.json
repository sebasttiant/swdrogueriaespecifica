{
  "name": "@drogueria/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "test:pg:operational": "prisma generate && vitest run --config vitest.postgres.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:demo": "tsx prisma/seed-demo.ts",
    "db:wipe": "tsx prisma/wipe.ts",
    "db:preflight": "tsx prisma/preflight-laboratory-identity.ts",
    "db:verify": "tsx prisma/verify-fulfillment-invariants.ts",
    "db:import:users": "tsx prisma/import-users.ts",
    "db:reconcile": "tsx prisma/reconcile-inventory.ts",
    "db:backfill:reportes": "tsx prisma/backfill-missing-reports.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "jose": "6.2.12",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
