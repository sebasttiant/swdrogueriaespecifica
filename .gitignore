# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/
**/standalone/

# Prisma generated client (regenerated via `pnpm db:generate`)
**/generated/prisma/

# Environment — never commit real secrets
.env
.env.local
.env.*.local

# Archivos de alta masiva de usuarios (db:import:users). Llevan contraseñas
# reales en texto plano: se crean, se corren y se borran. Nunca se versionan.
# Está acá para que no dependa de que alguien se acuerde: un `git add .` a las
# siete de la tarde no puede publicar las credenciales de la droguería.
usuarios*.json
users*.json
*.usuarios.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
.vitest/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local backups generated by deploy/ops scripts
backups/

# SDD / agent tooling artifacts — local planning only, never tracked
.atl/
openspec/
.codegraph/
