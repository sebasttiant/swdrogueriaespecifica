engine-strict=true
package-manager-strict=true
prefer-frozen-lockfile=true

# --------------------------------------------------------------------------
# minimumReleaseAge override (SOLO a nivel de proyecto).
#
# El entorno global tiene `minimumReleaseAge` activo (defensa de cadena de
# suministro que rechaza paquetes publicados hace muy poco). Este MVP fija a
# propósito versiones EXACTAS recién publicadas (Next 16.2.10, etc.), así que
# acá lo desactivamos para poder instalar lo que se mandó pinnear.
#
# Mitigación: todas las versiones son exactas (sin rangos) y quedan congeladas
# en pnpm-lock.yaml. Recomendado: subir este valor (p. ej. 1440 = 1 día) una
# vez que las versiones del stack maduren, y revisar el lockfile en cada bump.
# --------------------------------------------------------------------------
minimumReleaseAge=0
