# ==========================================================================
# Droguería Específica — variables de entorno (Fase 1)
#
# NOTA: este archivo se llama `env.example` (sin punto inicial) a propósito,
# porque la política de seguridad del entorno bloquea escribir archivos `.env*`.
# Uso:   cp env.example .env   y completá los valores reales.
# NUNCA comitees el `.env` con secretos reales.
# ==========================================================================

# --- PostgreSQL (usado por el servicio `postgres` de docker-compose) ---
POSTGRES_USER=drogueria
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=drogueria

# --- Conexión de la app a la base (OBLIGATORIA — fail-fast si falta) ---
# En Docker Compose el host es el nombre del servicio: `postgres`.
# En local fuera de Docker, usá `localhost`.
DATABASE_URL=postgresql://drogueria:change_me_in_real_env@postgres:5432/drogueria?schema=public

# --- Entorno ---
NODE_ENV=development

# --- Auth (FASE 2 — JWT stateless en cookie httpOnly) ---
# Secreto de firma del JWT de sesión. OBLIGATORIO (fail-fast). Mínimo 32 chars.
# Generá uno con:  openssl rand -base64 32
AUTH_SECRET=change_me_genera_uno_con_openssl_rand_base64_32

# Credenciales del admin para el seed de desarrollo (opcionales; el seed tiene
# valores de desarrollo por defecto si no se setean). Descomentá y poné los
# tuyos (estos son placeholders locales, NO valores reales).
# NUNCA usar valores de desarrollo en producción.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change_me_local_admin_password
